  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>FiscalDB</DataSourceName>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT fa.FiscalYear, c.Continent, fa.Amount
FROM FinancialAid fa
JOIN CountriesAndContinents c ON fa.CountryName = c.Country</CommandText>
      </Query>
      <Fields>
        <Field Name="FiscalYear">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>FiscalYear</DataField>
        </Field>
        <Field Name="Continent">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Continent</DataField>
        </Field>
        <Field Name="Amount">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Amount</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
